# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored.

# Postgres (Railway auto-injects this when the Postgres addon is linked
# to the app service; for local dev, point it at any Postgres instance)
DATABASE_URL=postgres://user:password@localhost:5432/dee_april_b2b

# Session signing — generate a random 32+ byte value, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me

# Resend transactional email — required
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=DEE <order@deeapril.com>

# Absolute site URL — used for email CTA links/logo and PDF invoice links.
# Defaults to https://order.maison-dee.com if unset.
#
# ⚠️ This value also decides whether email is allowed to leave at all. If its
# host is not a production portal host, lib/email.js refuses to send to anyone
# not in DEV_EMAIL_ALLOWLIST. That guard exists because between 3 and 26 July
# 2026 real retailers received emails full of http://localhost:3000 links: a
# local dev run held the production Resend key, and the locally seeded database
# carries real customer addresses, so a test order emailed the actual client.
SITE_URL=https://order.maison-dee.com

# Addresses allowed to receive mail when SITE_URL is NOT a production host
# (i.e. local development). Comma-separated. Put only your own addresses here.
# Leave empty and local runs send nothing at all, which is the safe default.
DEV_EMAIL_ALLOWLIST=

# e-conomic accounting sync — optional, silently no-op if unset.
# Live in production against Dorte's real account; see CLAUDE.md for the
# integration notes (recipient/product requirements, reference numbers).
ECONOMIC_APP_SECRET_TOKEN=
ECONOMIC_AGREEMENT_GRANT_TOKEN=
